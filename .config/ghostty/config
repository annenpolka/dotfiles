theme      = tokyonight
font-family = "SF Mono"
font-size   = 15
font-feature = -dlig
font-feature = -liga
font-feature = -calt

background-opacity = 0.99
background-blur    = 20
unfocused-split-opacity = 0.8

maximize = false
window-inherit-working-directory = true

# tmux-first workflow. Each Ghostty window starts a fresh tmux session, and
# zsh manually loads Ghostty shell integration so tmux-spawned shells keep it.
command = direct:/opt/homebrew/bin/tmux new-session
shell-integration-features = cursor,title,sudo,ssh-env,ssh-terminfo,path

# Use Cmd-T for a new window instead of a new tab.
keybind = super+t=new_window
